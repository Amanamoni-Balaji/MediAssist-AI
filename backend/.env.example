# ==========================================
# MediNLP Backend Environment Configuration
# ==========================================

# Set to False in production (True only for local debugging)
DEBUG=False

# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-very-long-and-random-secret-key-50-chars-min

# Comma-separated list of domain names/IPs this Django site can serve
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1

# Comma-separated list of origins authorized to make cross-site HTTP requests (your frontend URL)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:5173
